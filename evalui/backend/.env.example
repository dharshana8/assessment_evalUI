# EvalUI Configuration Settings Template

PROJECT_NAME="EvalUI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration
DB_TYPE="mongodb"
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="evalui_db"

# Relational Database Alternative:
DATABASE_URL="postgresql://evalui_user:evalui_password@localhost:5432/evalui_db"
# DATABASE_URL="sqlite:///./evalui.db"

# Local NLP Model Configuration
SEMANTIC_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
NLI_MODEL_NAME="cross-encoder/nli-distilroberta-base"
SPACY_MODEL_NAME="en_core_web_sm"

# Hybrid Scoring Weights
WEIGHT_SEMANTIC=0.45
WEIGHT_ENTAILMENT=0.45
WEIGHT_LEXICAL=0.10

# Guardrail & Detection Thresholds
CONTRADICTION_THRESHOLD=0.60
KEYWORD_STUFFING_SEMANTIC_MAX=0.45
KEYWORD_STUFFING_LEXICAL_MIN=0.70
